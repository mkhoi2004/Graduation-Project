{
  "name": "graduation-project",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "setup": "node scripts/setup-local.js",
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
