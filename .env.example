# SQL Server Express - Windows Authentication
DATABASE_URL=sqlserver://localhost:1433;database=Graduation-Project;integratedSecurity=true;trustServerCertificate=true;schema=dbo
JWT_SECRET=replace-with-a-long-random-secret-before-production
NODE_ENV=development
DEMO_SEED_ENABLED=false

# Backend
API_PORT=3000
FRONTEND_URL=http://localhost:5173

# Frontend
VITE_API_URL=http://localhost:3000/api

# MoMo sandbox (backend only)
MOMO_PARTNER_CODE=your-momo-partner-code
MOMO_ACCESS_KEY=your-momo-access-key
MOMO_SECRET_KEY=your-momo-secret-key
MOMO_REDIRECT_URL=http://localhost:3000/api/payments/momo/return
MOMO_IPN_URL=https://your-public-api.example.com/api/payments/momo/ipn

# VNPAY sandbox (backend only)
VNPAY_TMN_CODE=your-vnpay-tmn-code
VNPAY_HASH_SECRET=your-vnpay-hash-secret
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/api/payments/vnpay/return
VNPAY_IPN_URL=https://your-public-api.example.com/api/payments/vnpay/ipn

