  totalAmount  Int       @default(0)
  payloadJson  String    @db.NVarChar(Max)
  status       String    @db.VarChar(20)
  createdAt    DateTime? @db.DateTime2
  sentAt       DateTime? @db.DateTime2
  deletedAt    DateTime  @default(now()) @db.DateTime2
  deletedBy    String?   @db.NVarChar(100)
  deleteReason String?   @db.NVarChar(500)

  @@index([documentId])
  @@index([originalId])
  @@index([deletedAt])
}

// ==========================================
// HR & PERSONNEL ADMINISTRATION MODELS
// ==========================================

model Employee {
  id                 Int                @id @default(autoincrement())
  code               String             @unique @db.VarChar(50) // "NV-0001"
  fullName           String             @db.NVarChar(150)
  dateOfBirth        DateTime           @db.Date
  gender             String             @db.NVarChar(20) // "Nam" | "Nữ"
  phone              String             @unique @db.VarChar(20)
  email              String?            @db.VarChar(100)
  address            String?            @db.NVarChar(500)
  citizenId          String?            @db.VarChar(50)
  title              String             @db.NVarChar(100)
  department         String?            @db.NVarChar(100)
  roomId             Int?
  room               ClinicRoom?        @relation(fields: [roomId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  joinDate           DateTime           @db.Date
  status             String             @default("ACTIVE") @db.VarChar(20) // ACTIVE | TERMINATED
  terminationDate    DateTime?          @db.Date
  terminationReason  String?            @db.NVarChar(500)
  insuranceCode      String?            @db.VarChar(50)
  insuranceStartDate DateTime?          @db.Date
  bankName           String?            @db.NVarChar(100)
  bankAccountNumber  String?            @db.VarChar(50)
  bankAccountName    String?            @db.NVarChar(150)
  baseSalary         Int                @default(0)
  fixedAllowance     Int                @default(0)
  userId             Int?               @unique
  user               User?              @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  contracts          EmployeeContract[]
  shiftAssignments   ShiftAssignment[]
  attendances        AttendanceRecord[]
  payrollItems       PayrollItem[]
  incentives         ServiceIncentive[]
  createdAt          DateTime           @default(now()) @db.DateTime2
  updatedAt          DateTime           @updatedAt @db.DateTime2

  @@index([status, joinDate])
  @@index([phone])
  @@index([fullName])
  @@index([roomId])
}

model EmployeeContract {
  id             Int       @id @default(autoincrement())
  employeeId     Int
  employee       Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  contractNumber String    @db.VarChar(100)
  contractType   String    @db.VarChar(50) // THU_VIEC | XAC_DINH_THOI_HAN | KHONG_THOI_HAN | CHUYEN_GIA
  startDate      DateTime  @db.Date
  endDate        DateTime? @db.Date
  attachmentUrl  String?   @db.NVarChar(1000)
  note           String?   @db.NVarChar(500)
  createdAt      DateTime  @default(now()) @db.DateTime2

  @@index([employeeId, startDate])
}

model UserRoleAssignment {
  id           Int       @id @default(autoincrement())
  userId       Int
  user         User      @relation("UserRoleAssignments", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  roleId       Int
  role         Role      @relation("RoleAssignments", fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  isPrimary    Boolean   @default(false)
  isApproved   Boolean   @default(true)
  assignedById Int?
  approvedById Int?
  approvedAt   DateTime? @db.DateTime2
  createdAt    DateTime  @default(now()) @db.DateTime2

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model UserRoleAssignmentDeleted {
  id           Int       @id @default(autoincrement())
  originalId   Int?
  userId       Int
  roleId       Int
  isPrimary    Boolean   @default(false)
  isApproved   Boolean   @default(true)
  assignedById Int?
  approvedById Int?
  approvedAt   DateTime? @db.DateTime2
  createdAt    DateTime? @db.DateTime2
  deletedAt    DateTime  @default(now()) @db.DateTime2
  deletedBy    String?   @db.NVarChar(100)
  deleteReason String?   @db.NVarChar(500)

  @@index([userId])
  @@index([roleId])
  @@index([originalId])
  @@index([deletedAt])
}

model WorkShift {
  id               Int               @id @default(autoincrement())
  code             String            @unique @db.VarChar(50)
  name             String            @db.NVarChar(100)
  startTime        String            @db.VarChar(10)
  endTime          String            @db.VarChar(10)
  shiftType        String            @default("REGULAR") @db.VarChar(20)
  isActive         Boolean           @default(true)
  shiftAssignments ShiftAssignment[]
  createdAt        DateTime          @default(now()) @db.DateTime2
}

model ShiftAssignment {
  id         Int         @id @default(autoincrement())
  employeeId Int
  employee   Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  shiftId    Int
  shift      WorkShift   @relation(fields: [shiftId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  date       DateTime    @db.Date
  roomId     Int?
  room       ClinicRoom? @relation(fields: [roomId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  note       String?     @db.NVarChar(500)
  createdAt  DateTime    @default(now()) @db.DateTime2

  @@index([employeeId, date])
  @@index([date, roomId])
}

model AttendanceRecord {
  id                   Int       @id @default(autoincrement())
  employeeId           Int
  employee             Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  date                 DateTime  @db.Date
  status               String    @default("CHUA_CHECK_IN") @db.VarChar(30) // CHUA_CHECK_IN | DANG_LAM | DU_NGAY | CHI_SANG | CHI_CHIEU | THIEU_CHECK_OUT | VANG | NGHI_CO_LUONG | NGHI_KHONG_LUONG | PRESENT | LATE | ON_LEAVE
  checkInTime          String?   @db.VarChar(10)
  checkOutTime         String?   @db.VarChar(10)
  lateMinutes          Int       @default(0)
  leaveType            String?   @db.VarChar(30) // PAID_LEAVE | UNPAID_LEAVE
  overtimeHours        Decimal   @default(0) @db.Decimal(4, 2)
  sessionCount         Int       @default(0) // 0 | 1 | 2
  workUnits            Decimal   @default(0.0) @db.Decimal(3, 1) // 0 | 0.5 | 1.0
  source               String    @default("SELF") @db.VarChar(30) // SELF | HR
  roleUsed             String?   @db.VarChar(50)
  clinicRoomId         Int?
  configSnapshot       String?   @db.NVarChar(500) // Snapshot JSON: { startTime, endTime, splitTime }
  originalCheckInTime  String?   @db.VarChar(10)
  originalCheckOutTime String?   @db.VarChar(10)
  isAdjusted           Boolean   @default(false)
  adjustmentReason     String?   @db.NVarChar(500)
  adjustedById         Int?
  approvalStatus       String    @default("APPROVED") @db.VarChar(30) // APPROVED | PENDING_APPROVAL | REJECTED
  approvedById         Int?
  approvedAt           DateTime? @db.DateTime2
  hasLeaveConflict     Boolean   @default(false)
  conflictNote         String?   @db.NVarChar(500)
  isOnDuty             Boolean   @default(false)
  isLocked             Boolean   @default(false)
  note                 String?   @db.NVarChar(500)
  recordedById         Int?
  createdAt            DateTime  @default(now()) @db.DateTime2
  updatedAt            DateTime  @updatedAt @db.DateTime2

  audits AttendanceAudit[]

  @@unique([employeeId, date])
  @@index([date, status])
}

model AttendanceAudit {
  id                   Int              @id @default(autoincrement())
  attendanceRecordId   Int
  attendanceRecord     AttendanceRecord @relation(fields: [attendanceRecordId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  action               String           @db.VarChar(50) // CHECK_IN | CHECK_OUT | HR_ADJUST | APPROVE | REJECT
  originalCheckInTime  String?          @db.VarChar(10)
  originalCheckOutTime String?          @db.VarChar(10)
  newCheckInTime       String?          @db.VarChar(10)
  newCheckOutTime      String?          @db.VarChar(10)
  reason               String?          @db.NVarChar(500)
  actorId              Int?
  actorRole            String?          @db.VarChar(50)
  createdAt            DateTime         @default(now()) @db.DateTime2

  @@index([attendanceRecordId, createdAt])
}

model WorkingHoursConfig {
  id            Int      @id @default(autoincrement())
  startTime     String   @default("09:00") @db.VarChar(10) // HH:mm
  endTime       String   @default("18:00") @db.VarChar(10) // HH:mm
  splitTime     String   @default("12:00") @db.VarChar(10) // HH:mm
  effectiveDate DateTime @db.Date
  note          String?  @db.NVarChar(500)
  createdById   Int?
  createdAt     DateTime @default(now()) @db.DateTime2
  updatedAt     DateTime @updatedAt @db.DateTime2

  audits WorkingHoursAudit[]

  @@index([effectiveDate])
}

model WorkingHoursAudit {
  id          Int                @id @default(autoincrement())
  configId    Int
  config      WorkingHoursConfig @relation(fields: [configId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  action      String             @db.VarChar(50) // CREATE | UPDATE
  oldData     String?            @db.NVarChar(Max)
  newData     String             @db.NVarChar(Max)
  changedById Int?
  changedAt   DateTime           @default(now()) @db.DateTime2

  @@index([configId, changedAt])
}

model Payroll {
  id                  Int           @id @default(autoincrement())
  code                String        @unique @db.VarChar(50) // BL202610/0001
  year                Int
  month               Int
  title               String        @db.NVarChar(150)
  standardWorkingDays Decimal       @db.Decimal(4, 1)
  status              String        @default("DRAFT") @db.VarChar(20) // DRAFT | APPROVED | LOCKED | PAID | CANCELLED
  createdById         Int
  createdBy           User          @relation("PayrollCreatedBy", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  approvedById        Int?
  approvedBy          User?         @relation("PayrollApprovedBy", fields: [approvedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  approvedAt          DateTime?     @db.DateTime2
  lockedAt            DateTime?     @db.DateTime2
  paidAt              DateTime?     @db.DateTime2
  totalGross          Int           @default(0)
  totalDeductions     Int           @default(0)
  totalNet            Int           @default(0)
  cancelReason        String?       @db.NVarChar(500)
  note                String?       @db.NVarChar(500)
  items               PayrollItem[]
  createdAt           DateTime      @default(now()) @db.DateTime2
  updatedAt           DateTime      @updatedAt @db.DateTime2

  @@unique([year, month, code])
  @@index([status, year, month])
}

model PayrollItem {
  id                     Int       @id @default(autoincrement())
  payrollId              Int
  payroll                Payroll   @relation(fields: [payrollId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  employeeId             Int
  employee               Employee  @relation(fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  baseSalary             Int
  standardDays           Decimal   @db.Decimal(4, 1)
  actualDays             Decimal   @db.Decimal(4, 1)
  attendanceSalary       Int
  allowanceAmount        Int
  serviceIncentiveAmount Int
  otherBonus             Int       @default(0)
  overtimePay            Int       @default(0)
  grossSalary            Int
  insuranceDeduction     Int       @default(0)
  advanceDeduction       Int       @default(0)
  otherDeduction         Int       @default(0)
  totalDeductions        Int
  netSalary              Int
  accountingPayableId    Int?
  isPaid                 Boolean   @default(false)
  paidAt                 DateTime? @db.DateTime2
  createdAt              DateTime  @default(now()) @db.DateTime2

  @@unique([payrollId, employeeId])
  @@index([employeeId])
}

model ServiceIncentive {
  id              Int      @id @default(autoincrement())
  intakeServiceId Int
  examinationId   Int
  employeeId      Int
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  roleType        String   @db.VarChar(20) // DOCTOR | RECEPTION
  serviceName     String   @db.NVarChar(150)
  serviceAmount   Int
  rate            Decimal  @default(5.00) @db.Decimal(5, 2)
  incentiveAmount Int
  status          String   @default("VALID") @db.VarChar(20) // VALID | PAUSED | EXCLUDED | NEEDS_ATTENTION
  payrollItemId   Int?
  statusReason    String?  @db.NVarChar(500)
  completedAt     DateTime @db.DateTime2
  createdAt       DateTime @default(now()) @db.DateTime2

  @@unique([intakeServiceId, roleType])
  @@index([employeeId, status])
  @@index([examinationId])
}

model HrAuditLog {
  id          Int      @id @default(autoincrement())
  entityType  String   @db.VarChar(50)
  entityId    Int
  action      String   @db.VarChar(50)
  actorId     Int?
  detailsJson String?  @db.NVarChar(Max)
  createdAt   DateTime @default(now()) @db.DateTime2

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}

model RoleConfiguration {
  id          Int      @id @default(autoincrement())
  configKey   String   @unique @db.VarChar(80)
  configValue String   @db.NVarChar(Max)
  description String?  @db.NVarChar(500)
  updatedById Int?
  updatedAt   DateTime @default(now()) @db.DateTime2
}
