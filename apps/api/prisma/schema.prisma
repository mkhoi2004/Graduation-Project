// Add domain models here as each Dental ERP module is introduced.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model Role {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(50)
  name        String   @db.NVarChar(100)
  description String   @db.NVarChar(1000)
  users       User[]
  createdAt   DateTime @default(now()) @db.DateTime2
  updatedAt   DateTime @updatedAt @db.DateTime2
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique @db.VarChar(50)
  fullName     String   @db.NVarChar(150)
  passwordHash String   @db.VarChar(255)
  isActive     Boolean  @default(true)
  roleId       Int
  role         Role     @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt    DateTime @default(now()) @db.DateTime2
  updatedAt    DateTime @updatedAt @db.DateTime2

  doctorIntakes      Intake[]                  @relation("DoctorIntakes")
  createdIntakes     Intake[]                  @relation("StaffCreatedIntakes")
  payments           Payment[]                 @relation("CashierPayments")
  doctorExaminations DoctorExamination[]       @relation("DoctorExaminations")
  printedHistories   ExaminationPrintHistory[] @relation("DoctorPrintHistories")
  auditLogs          ExaminationAuditLog[]     @relation("ExaminationAuditActors")

  @@index([roleId])
}

model Patient {
  id                 Int                 @id @default(autoincrement())
  code               String              @unique @db.VarChar(50)
  fullName           String              @db.NVarChar(150)
  dateOfBirth        DateTime            @db.Date
  gender             String              @db.NVarChar(10)
  phone              String              @unique @db.VarChar(20)
  address            String?             @db.NVarChar(500)
  note               String?             @db.NVarChar(1000)
  intakes            Intake[]
  doctorExaminations DoctorExamination[]
  createdAt          DateTime            @default(now()) @db.DateTime2
  updatedAt          DateTime            @updatedAt @db.DateTime2

  @@index([phone])
  @@index([fullName])
}

model ClinicRoom {
  id                 Int                 @id @default(autoincrement())
  code               String              @unique @db.VarChar(50)
  name               String              @db.NVarChar(100)
  description        String?             @db.NVarChar(500)
  isActive           Boolean             @default(true)
  intakes            Intake[]
  doctorExaminations DoctorExamination[]
  createdAt          DateTime            @default(now()) @db.DateTime2
  updatedAt          DateTime            @updatedAt @db.DateTime2
}

model DentalService {
  id             Int             @id @default(autoincrement())
  code           String          @unique @db.VarChar(50)
  name           String          @db.NVarChar(150)
  category       String          @db.NVarChar(100)
  price          Int
  unit           String          @db.NVarChar(50)
  isActive       Boolean         @default(true)
  intakeServices IntakeService[]
  createdAt      DateTime        @default(now()) @db.DateTime2
  updatedAt      DateTime        @updatedAt @db.DateTime2

  @@index([category])
}

model Intake {
  id            Int                @id @default(autoincrement())
  code          String             @unique @db.VarChar(50)
  patientId     Int
  patient       Patient            @relation(fields: [patientId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  symptoms      String             @db.NVarChar(1000)
  priority      String             @default("NORMAL") @db.NVarChar(50)
  status        String             @default("DRAFT") @db.VarChar(20)
  roomId        Int?
  room          ClinicRoom?        @relation(fields: [roomId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  doctorId      Int?
  doctor        User?              @relation("DoctorIntakes", fields: [doctorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdById   Int?
  createdBy     User?              @relation("StaffCreatedIntakes", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  transferredAt DateTime?          @db.DateTime2
  services      IntakeService[]
  payments      Payment[]
  examination   DoctorExamination?
  createdAt     DateTime           @default(now()) @db.DateTime2
  updatedAt     DateTime           @updatedAt @db.DateTime2

  @@index([patientId])
  @@index([status])
  @@index([doctorId])
  @@index([roomId])
}

model IntakeService {
  id        Int           @id @default(autoincrement())
  intakeId  Int
  intake    Intake        @relation(fields: [intakeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  serviceId Int
  service   DentalService @relation(fields: [serviceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  quantity  Int           @default(1)
  unitPrice Int
  amount    Int
  createdAt DateTime      @default(now()) @db.DateTime2
  updatedAt DateTime      @updatedAt @db.DateTime2

  @@unique([intakeId, serviceId])
  @@index([intakeId])
  @@index([serviceId])
}

model Payment {
  id             Int       @id @default(autoincrement())
  intakeId       Int?
  intake         Intake?   @relation(fields: [intakeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  intakeCode     String    @db.VarChar(50)
  orderId        String    @unique @db.VarChar(100)
  requestId      String    @unique @db.VarChar(100)
  partnerCode    String    @db.VarChar(50)
  method         String    @db.VarChar(20)
  status         String    @db.VarChar(20)
  amount         Int
  gatewayPayload String?   @db.NVarChar(Max)
  paidAt         DateTime? @db.DateTime2
  createdById    Int?
  createdBy      User?     @relation("CashierPayments", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt      DateTime  @default(now()) @db.DateTime2
  updatedAt      DateTime  @updatedAt @db.DateTime2

  @@index([intakeId])
  @@index([intakeCode])
  @@index([status])
}

// ==========================================
// BACKUP / AUDIT TABLES FOR DELETED RECORDS
// ==========================================

model RoleDeleted {
  id           Int       @id @default(autoincrement())
  originalId   Int?
  code         String    @db.VarChar(50)
  name         String    @db.NVarChar(100)
  description  String    @db.NVarChar(1000)
  createdAt    DateTime? @db.DateTime2
  updatedAt    DateTime? @db.DateTime2
  deletedAt    DateTime  @default(now()) @db.DateTime2
  deletedBy    String?   @db.NVarChar(100)
  deleteReason String?   @db.NVarChar(500)

  @@index([code])
  @@index([originalId])
  @@index([deletedAt])
}

model UserDeleted {
  id           Int       @id @default(autoincrement())
  originalId   Int?
  username     String    @db.VarChar(50)
  fullName     String    @db.NVarChar(150)
  passwordHash String    @db.VarChar(255)
  isActive     Boolean   @default(true)
  roleId       Int?
  createdAt    DateTime? @db.DateTime2
  updatedAt    DateTime? @db.DateTime2
  deletedAt    DateTime  @default(now()) @db.DateTime2
  deletedBy    String?   @db.NVarChar(100)
  deleteReason String?   @db.NVarChar(500)

  @@index([username])
  @@index([originalId])
  @@index([roleId])
  @@index([deletedAt])
}

model PatientDeleted {
  id           Int       @id @default(autoincrement())
  originalId   Int?
  code         String    @db.VarChar(50)
  fullName     String    @db.NVarChar(150)
  dateOfBirth  DateTime  @db.Date
  gender       String    @db.NVarChar(10)
  phone        String    @db.VarChar(20)
  address      String?   @db.NVarChar(500)
  note         String?   @db.NVarChar(1000)
  createdAt    DateTime? @db.DateTime2
  updatedAt    DateTime? @db.DateTime2
  deletedAt    DateTime  @default(now()) @db.DateTime2
  deletedBy    String?   @db.NVarChar(100)
  deleteReason String?   @db.NVarChar(500)

  @@index([code])
  @@index([phone])
  @@index([fullName])
  @@index([originalId])
  @@index([deletedAt])
}

model ClinicRoomDeleted {
  id           Int       @id @default(autoincrement())
  originalId   Int?
  code         String    @db.VarChar(50)
  name         String    @db.NVarChar(100)
  description  String?   @db.NVarChar(500)
  isActive     Boolean   @default(true)
  createdAt    DateTime? @db.DateTime2
  updatedAt    DateTime? @db.DateTime2
  deletedAt    DateTime  @default(now()) @db.DateTime2
  deletedBy    String?   @db.NVarChar(100)
  deleteReason String?   @db.NVarChar(500)

  @@index([code])
  @@index([originalId])
  @@index([deletedAt])
}

model DentalServiceDeleted {
  id           Int       @id @default(autoincrement())
  originalId   Int?
  code         String    @db.VarChar(50)
  name         String    @db.NVarChar(150)
  category     String    @db.NVarChar(100)
  price        Int
  unit         String    @db.NVarChar(50)
  isActive     Boolean   @default(true)
  createdAt    DateTime? @db.DateTime2
  updatedAt    DateTime? @db.DateTime2
  deletedAt    DateTime  @default(now()) @db.DateTime2
  deletedBy    String?   @db.NVarChar(100)
  deleteReason String?   @db.NVarChar(500)

  @@index([code])
  @@index([category])
  @@index([originalId])
  @@index([deletedAt])
}

model IntakeDeleted {
  id            Int       @id @default(autoincrement())
  originalId    Int?
  code          String    @db.VarChar(50)
  patientId     Int
  patientCode   String?   @db.VarChar(50)
  symptoms      String    @db.NVarChar(1000)
  priority      String    @default("NORMAL") @db.NVarChar(50)
  status        String    @default("DRAFT") @db.VarChar(20)
  roomId        Int?
  doctorId      Int?
  createdById   Int?
  transferredAt DateTime? @db.DateTime2
  createdAt     DateTime? @db.DateTime2
  updatedAt     DateTime? @db.DateTime2
  deletedAt     DateTime  @default(now()) @db.DateTime2
  deletedBy     String?   @db.NVarChar(100)
  deleteReason  String?   @db.NVarChar(500)

  @@index([code])
  @@index([patientId])
  @@index([originalId])
  @@index([status])
  @@index([deletedAt])
}

model IntakeServiceDeleted {
  id           Int       @id @default(autoincrement())
  originalId   Int?
  intakeId     Int
  serviceId    Int
  quantity     Int       @default(1)
  unitPrice    Int
  amount       Int
  createdAt    DateTime? @db.DateTime2
  updatedAt    DateTime? @db.DateTime2
  deletedAt    DateTime  @default(now()) @db.DateTime2
  deletedBy    String?   @db.NVarChar(100)
  deleteReason String?   @db.NVarChar(500)

  @@index([intakeId])
  @@index([serviceId])
  @@index([originalId])
  @@index([deletedAt])
}

model PaymentDeleted {
  id             Int       @id @default(autoincrement())
  originalId     Int?
  intakeId       Int?
  intakeCode     String    @db.VarChar(50)
  orderId        String    @db.VarChar(100)
  requestId      String    @db.VarChar(100)
  partnerCode    String    @db.VarChar(50)
  method         String    @db.VarChar(20)
  status         String    @db.VarChar(20)
  amount         Int
  gatewayPayload String?   @db.NVarChar(Max)
  paidAt         DateTime? @db.DateTime2
  createdById    Int?
  createdAt      DateTime? @db.DateTime2
  updatedAt      DateTime? @db.DateTime2
  deletedAt      DateTime  @default(now()) @db.DateTime2
  deletedBy      String?   @db.NVarChar(100)
  deleteReason   String?   @db.NVarChar(500)

  @@index([orderId])
  @@index([intakeCode])
  @@index([intakeId])
  @@index([originalId])
  @@index([deletedAt])
}

// ==========================================
// DOCTOR CLINICAL EXAMINATION MODELS
// ==========================================

model DoctorExamination {
  id               Int                       @id @default(autoincrement())
  code             String                    @unique @db.VarChar(50)
  intakeId         Int                       @unique
  intake           Intake                    @relation(fields: [intakeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  patientId        Int
  patient          Patient                   @relation(fields: [patientId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  doctorId         Int
  doctor           User                      @relation("DoctorExaminations", fields: [doctorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  roomId           Int
  room             ClinicRoom                @relation(fields: [roomId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  status           String                    @default("IN_PROGRESS") @db.VarChar(20) // IN_PROGRESS | COMPLETED | CANCELLED
  startedAt        DateTime                  @default(now()) @db.DateTime2
  completedAt      DateTime?                 @db.DateTime2
  cancelReason     String?                   @db.NVarChar(500)
  isLocked         Boolean                   @default(false)
  supplies         ExaminationSupply[]
  reservations     SupplyReservation[]
  result           ExaminationResult?
  printHistories   ExaminationPrintHistory[]
  accountingOutbox AccountingOutbox?
  auditLogs        ExaminationAuditLog[]
  createdAt        DateTime                  @default(now()) @db.DateTime2
  updatedAt        DateTime                  @updatedAt @db.DateTime2

  @@index([doctorId, status])
  @@index([roomId, status])
  @@index([patientId])
  @@index([status])
}

model MedicalSupply {
  id                  Int                 @id @default(autoincrement())
  code                String              @unique @db.VarChar(50)
  name                String              @db.NVarChar(150)
  group               String              @db.VarChar(20) // 'THUONG' | 'VO_CAM'
  baseUnit            String              @db.NVarChar(50) // 'Cái', 'Tuýp', 'Kim', 'Bơm', 'Ống'
  conversionUnit      String?             @db.NVarChar(50) // 'Hộp'
  conversionRate      Int?                // e.g. 60, 100, 50
  costPrice           Int                 // Giá vốn nội bộ (VND) - không hiển thị cho bác sĩ
  inStock             Int                 @default(1000)
  minimumStock        Int                 @default(10)
  expiryWarningDays   Int                 @default(90)
  isBaseUnitDivisible Boolean             @default(false)
  isActive            Boolean             @default(true)
  examinationSupplies ExaminationSupply[]
  reservations        SupplyReservation[]
  inventoryBatches    InventoryBatch[]
  stockDocumentLines  StockDocumentLine[]
  stockLedgerEntries  StockLedgerEntry[]
  createdAt           DateTime            @default(now()) @db.DateTime2
  updatedAt           DateTime            @updatedAt @db.DateTime2

  @@index([group])
}

model Supplier {
  id          Int             @id @default(autoincrement())
  code        String          @unique @db.VarChar(30)
  name        String          @db.NVarChar(200)
  phone       String?         @db.VarChar(30)
  address     String?         @db.NVarChar(500)
  taxCode     String?         @db.VarChar(30)
  isActive    Boolean         @default(true)
  documents   StockDocument[]
  createdAt   DateTime        @default(now()) @db.DateTime2
  updatedAt   DateTime        @updatedAt @db.DateTime2
}

model InventoryBatch {
  id                  Int               @id @default(autoincrement())
  supplyId            Int
  supply              MedicalSupply     @relation(fields: [supplyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  batchNo             String?           @db.VarChar(80)
  expiryDate          DateTime?         @db.Date
  quantity            Decimal           @default(0) @db.Decimal(18, 4)
  unitCost            Decimal           @default(0) @db.Decimal(18, 4)
  originalReceiptCode String?           @db.VarChar(40)
  receivedAt          DateTime          @default(now()) @db.DateTime2
  allocations         StockAllocation[]
  ledgerEntries       StockLedgerEntry[]

  @@index([supplyId, expiryDate, receivedAt])
  @@index([quantity])
}

model StockDocument {
  id                    Int                        @id @default(autoincrement())
  code                  String                     @unique @db.VarChar(40)
  type                  String                     @db.VarChar(10)
  outboundType          String?                    @db.VarChar(20)
  status                String                     @default("DRAFT") @db.VarChar(20)
  supplierId            Int?
  supplier              Supplier?                  @relation(fields: [supplierId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  patientId             Int?
  examinationId         Int?
  doctorId              Int?
  roomId                Int?
  intakeId              Int?
  recipientDepartment   String?                    @db.NVarChar(150)
  reason                String?                    @db.NVarChar(500)
  nonFefoReason         String?                    @db.NVarChar(500)
  idempotencyKey        String?                    @db.VarChar(100)
  originalDocumentId    Int?
  originalDocument      StockDocument?             @relation("StockDocumentReversal", fields: [originalDocumentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reversalDocuments     StockDocument[]            @relation("StockDocumentReversal")
  goodsAmount           Int                        @default(0)
  vatAmount             Int                        @default(0)
  totalAmount           Int                        @default(0)
  contentHash           String?                    @db.VarChar(128)
  printCount            Int                        @default(0)
  isLocked              Boolean                    @default(false)
  createdById           Int?
  postedById            Int?
  printedAt             DateTime?                  @db.DateTime2
  postedAt              DateTime?                  @db.DateTime2
  cancelledAt           DateTime?                  @db.DateTime2
  createdAt             DateTime                   @default(now()) @db.DateTime2
  updatedAt             DateTime                   @updatedAt @db.DateTime2
  lines                 StockDocumentLine[]
  ledgerEntries         StockLedgerEntry[]
  printLogs             WarehousePrintLog[]
  auditLogs             WarehouseAuditLog[]
  accountingEntries     AccountingWarehouseEntry[]

  @@index([type, status, createdAt])
  @@index([examinationId])
  @@index([patientId])
  @@index([idempotencyKey])
}

model StockDocumentLine {
  id                  Int               @id @default(autoincrement())
  documentId          Int
  document            StockDocument     @relation(fields: [documentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  supplyId            Int
  supply              MedicalSupply     @relation(fields: [supplyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  inputQuantity       Decimal           @db.Decimal(18, 4)
  inputUnit           String            @db.NVarChar(50)
  conversionFactor    Decimal           @default(1) @db.Decimal(18, 4)
  convertedQuantity   Decimal           @db.Decimal(18, 4)
  batchNo             String?           @db.VarChar(80)
  expiryDate          DateTime?         @db.Date
  inputUnitPrice      Decimal           @default(0) @db.Decimal(18, 2)
  vatRate             Decimal           @default(0) @db.Decimal(5, 2)
  goodsAmount         Int               @default(0)
  vatAmount           Int               @default(0)
  totalAmount         Int               @default(0)
  allocations         StockAllocation[]
  ledgerEntries       StockLedgerEntry[]

  @@index([documentId])
  @@index([supplyId])
}

model StockAllocation {
  id              Int               @id @default(autoincrement())
  documentLineId  Int
  documentLine    StockDocumentLine @relation(fields: [documentLineId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  batchId         Int
  batch           InventoryBatch    @relation(fields: [batchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  quantity        Decimal           @db.Decimal(18, 4)
  unitCost        Decimal           @db.Decimal(18, 4)
  amount          Int

  @@index([batchId])
}

model StockLedgerEntry {
  id              Int                @id @default(autoincrement())
  documentId      Int
  document        StockDocument      @relation(fields: [documentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  documentLineId  Int
  documentLine    StockDocumentLine  @relation(fields: [documentLineId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  supplyId        Int
  supply          MedicalSupply      @relation(fields: [supplyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  batchId         Int?
  batch           InventoryBatch?    @relation(fields: [batchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  direction       String              @db.VarChar(10)
  quantity        Decimal             @db.Decimal(18, 4)
  unitCost        Decimal             @db.Decimal(18, 4)
  amount          Int
  balanceAfter    Decimal             @db.Decimal(18, 4)
  createdAt       DateTime            @default(now()) @db.DateTime2

  @@index([supplyId, createdAt])
  @@index([documentId])
}

model WarehousePrintLog {
  id              Int           @id @default(autoincrement())
  documentId      Int
  document        StockDocument @relation(fields: [documentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  printedById     Int?
  contentHash     String         @db.VarChar(128)
  isCopy          Boolean        @default(false)
  printedAt       DateTime       @default(now()) @db.DateTime2

  @@index([documentId, printedAt])
}

model WarehouseAuditLog {
  id              Int           @id @default(autoincrement())
  documentId      Int
  document        StockDocument @relation(fields: [documentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  action          String         @db.VarChar(50)
  actorId         Int?
  changesJson     String?        @db.NVarChar(Max)
  createdAt       DateTime       @default(now()) @db.DateTime2

  @@index([documentId, createdAt])
}

model AccountingWarehouseEntry {
  id              Int           @id @default(autoincrement())
  documentId      Int
  document        StockDocument @relation(fields: [documentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  eventType       String         @db.VarChar(40)
  goodsAmount     Int            @default(0)
  vatAmount       Int            @default(0)
  totalAmount     Int            @default(0)
  payloadJson     String         @db.NVarChar(Max)
  status          String         @default("PENDING") @db.VarChar(20)
  createdAt       DateTime       @default(now()) @db.DateTime2
  sentAt          DateTime?      @db.DateTime2

  @@index([status, createdAt])
}

model ExaminationSupply {
  id                 Int               @id @default(autoincrement())
  examinationId      Int
  examination        DoctorExamination @relation(fields: [examinationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  supplyId           Int
  supply             MedicalSupply     @relation(fields: [supplyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  conversionUnitUsed String?           @db.NVarChar(50)
  quantityInBaseUnit Int
  costPriceSnapshot  Int
  createdAt          DateTime          @default(now()) @db.DateTime2
  updatedAt          DateTime          @updatedAt @db.DateTime2

  @@index([examinationId])
  @@index([supplyId])
}

model SupplyReservation {
  id            Int               @id @default(autoincrement())
  examinationId Int
  examination   DoctorExamination @relation(fields: [examinationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  supplyId      Int
  supply        MedicalSupply     @relation(fields: [supplyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  quantity      Int
  status        String            @default("RESERVED") @db.VarChar(20) // RESERVED | DEDUCTED | RELEASED
  createdAt     DateTime          @default(now()) @db.DateTime2
  updatedAt     DateTime          @updatedAt @db.DateTime2

  @@index([examinationId])
  @@index([supplyId])
  @@index([status])
}

model ExaminationResult {
  id                   Int               @id @default(autoincrement())
  examinationId        Int               @unique
  examination          DoctorExamination @relation(fields: [examinationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  summary              String            @db.NVarChar(2000)
  treatmentMethod      String            @db.NVarChar(2000)
  treatmentOrientation String            @db.NVarChar(2000)
  nextAppointmentDate  DateTime?         @db.Date
  createdAt            DateTime          @default(now()) @db.DateTime2
  updatedAt            DateTime          @updatedAt @db.DateTime2
}

model ExaminationPrintHistory {
  id              Int               @id @default(autoincrement())
  examinationId   Int
  examination     DoctorExamination @relation(fields: [examinationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  printedById     Int?
  printedBy       User?             @relation("DoctorPrintHistories", fields: [printedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  printedAt       DateTime          @default(now()) @db.DateTime2
  contentSnapshot String            @db.NVarChar(Max)

  @@index([examinationId])
  @@index([printedById])
}

model AccountingOutbox {
  id             Int               @id @default(autoincrement())
  examinationId  Int               @unique
  examination    DoctorExamination @relation(fields: [examinationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  serviceRevenue Int
  supplyCost     Int
  isCancelled    Boolean           @default(false)
  status         String            @default("PENDING") @db.VarChar(20) // PENDING | SENT | FAILED
  payload        String?           @db.NVarChar(Max)
  sentAt         DateTime?         @db.DateTime2
  createdAt      DateTime          @default(now()) @db.DateTime2
  updatedAt      DateTime          @updatedAt @db.DateTime2

  @@index([status])
}

model ExaminationAuditLog {
  id            Int               @id @default(autoincrement())
  examinationId Int
  examination   DoctorExamination @relation(fields: [examinationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  action        String            @db.VarChar(50)
  actorId       Int?
  actor         User?             @relation("ExaminationAuditActors", fields: [actorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reason        String            @db.NVarChar(500)
  changesJson   String?           @db.NVarChar(Max)
  createdAt     DateTime          @default(now()) @db.DateTime2

  @@index([examinationId])
  @@index([actorId])
}

