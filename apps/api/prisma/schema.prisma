// Add domain models here as each Dental ERP module is introduced.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model Role {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(50)
  name        String   @db.NVarChar(100)
  description String   @db.NVarChar(1000)
  users       User[]
  createdAt   DateTime @default(now()) @db.DateTime2
  updatedAt   DateTime @updatedAt @db.DateTime2
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique @db.VarChar(50)
  fullName     String   @db.NVarChar(150)
  passwordHash String   @db.VarChar(255)
  isActive     Boolean  @default(true)
  roleId       Int
  role         Role     @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt    DateTime @default(now()) @db.DateTime2
  updatedAt    DateTime @updatedAt @db.DateTime2

  doctorIntakes      Intake[]                  @relation("DoctorIntakes")
  createdIntakes     Intake[]                  @relation("StaffCreatedIntakes")
  payments           Payment[]                 @relation("CashierPayments")
  doctorExaminations DoctorExamination[]       @relation("DoctorExaminations")
  printedHistories   ExaminationPrintHistory[] @relation("DoctorPrintHistories")
  auditLogs          ExaminationAuditLog[]     @relation("ExaminationAuditActors")

  @@index([roleId])
}

model Patient {
  id                 Int                 @id @default(autoincrement())
  code               String              @unique @db.VarChar(50)
  fullName           String              @db.NVarChar(150)
  dateOfBirth        DateTime            @db.Date
  gender             String              @db.NVarChar(10)
  phone              String              @unique @db.VarChar(20)
  address            String?             @db.NVarChar(500)
  note               String?             @db.NVarChar(1000)
  intakes            Intake[]
  doctorExaminations DoctorExamination[]
  createdAt          DateTime            @default(now()) @db.DateTime2
  updatedAt          DateTime            @updatedAt @db.DateTime2

  @@index([phone])
  @@index([fullName])
}

model ClinicRoom {
  id                 Int                 @id @default(autoincrement())
  code               String              @unique @db.VarChar(50)
  name               String              @db.NVarChar(100)
  description        String?             @db.NVarChar(500)
  isActive           Boolean             @default(true)
  intakes            Intake[]
  doctorExaminations DoctorExamination[]
  createdAt          DateTime            @default(now()) @db.DateTime2
  updatedAt          DateTime            @updatedAt @db.DateTime2
}

model DentalService {
  id             Int             @id @default(autoincrement())
  code           String          @unique @db.VarChar(50)
  name           String          @db.NVarChar(150)
  category       String          @db.NVarChar(100)
  price          Int
  unit           String          @db.NVarChar(50)
  isActive       Boolean         @default(true)
  intakeServices IntakeService[]
  createdAt      DateTime        @default(now()) @db.DateTime2
  updatedAt      DateTime        @updatedAt @db.DateTime2

  @@index([category])
}

model Intake {
  id            Int                @id @default(autoincrement())
  code          String             @unique @db.VarChar(50)
  patientId     Int
  patient       Patient            @relation(fields: [patientId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  symptoms      String             @db.NVarChar(1000)
  priority      String             @default("NORMAL") @db.NVarChar(50)
  status        String             @default("DRAFT") @db.VarChar(20)
  roomId        Int?
  room          ClinicRoom?        @relation(fields: [roomId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  doctorId      Int?
  doctor        User?              @relation("DoctorIntakes", fields: [doctorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdById   Int?
  createdBy     User?              @relation("StaffCreatedIntakes", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  transferredAt DateTime?          @db.DateTime2
  services      IntakeService[]
  payments      Payment[]
  examination   DoctorExamination?
  createdAt     DateTime           @default(now()) @db.DateTime2
  updatedAt     DateTime           @updatedAt @db.DateTime2

  @@index([patientId])
  @@index([status])
  @@index([doctorId])
  @@index([roomId])
}

model IntakeService {
  id        Int           @id @default(autoincrement())
  intakeId  Int
  intake    Intake        @relation(fields: [intakeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  serviceId Int
  service   DentalService @relation(fields: [serviceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  quantity  Int           @default(1)
  unitPrice Int
  amount    Int
  createdAt DateTime      @default(now()) @db.DateTime2
  updatedAt DateTime      @updatedAt @db.DateTime2

  @@unique([intakeId, serviceId])
  @@index([intakeId])
  @@index([serviceId])
}

model Payment {
  id             Int       @id @default(autoincrement())
  intakeId       Int?
  intake         Intake?   @relation(fields: [intakeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  intakeCode     String    @db.VarChar(50)
  orderId        String    @unique @db.VarChar(100)
  requestId      String    @unique @db.VarChar(100)
  partnerCode    String    @db.VarChar(50)
  method         String    @db.VarChar(20)
  status         String    @db.VarChar(20)
  amount         Int
  gatewayPayload String?   @db.NVarChar(Max)
  paidAt         DateTime? @db.DateTime2
  createdById    Int?
  createdBy      User?     @relation("CashierPayments", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt      DateTime  @default(now()) @db.DateTime2
  updatedAt      DateTime  @updatedAt @db.DateTime2

  @@index([intakeId])
  @@index([intakeCode])
  @@index([status])
}

